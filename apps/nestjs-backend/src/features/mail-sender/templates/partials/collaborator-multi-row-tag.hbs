<tr>
  <td>
    <p class='text' style='margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #3F4749;'>{{{title}}}:</p>
    <table role='presentation' width='100%' border='0' cellpadding='0' cellspacing='0'>
      {{#each recordTitles}}
        <tr>
          <td class='rule' style='padding: 10px 0; border-top: 1px solid #ECECEA; font-size: 14px; line-height: 20px;'>
            <a
              href='{{../viewRecordUrlPrefix}}?recordId={{this.id}}&fromNotify={{../notifyId}}'
              target='_blank'
              title='{{this.title}}'
              style='color: #2B7A89; font-weight: 500; text-decoration: none;'
            >{{this.title}}&nbsp;&rarr;</a>
          </td>
        </tr>
      {{/each}}
    </table>
  </td>
</tr>
