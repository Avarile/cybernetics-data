<tr>
  <td>
    <h1 class='h1' style='margin: 0 0 16px; font-size: 20px; line-height: 28px; font-weight: 600; color: #14191A;'>{{{title}}}</h1>
    <p class='text' style='margin: 0 0 24px; font-size: 15px; line-height: 24px; color: #3F4749;'>{{{message}}}</p>
    <p class='code' style="margin: 0 0 24px; font-family: 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace; font-size: 36px; line-height: 44px; font-weight: 600; letter-spacing: 6px; color: #14191A;">{{code}}</p>
    <p class='text' style='margin: 0 0 28px; font-size: 15px; line-height: 24px; color: #3F4749;'>{{expiresNote}}</p>
    <table role='presentation' width='100%' border='0' cellpadding='0' cellspacing='0'>
      <tr>
        <td class='callout' style='background-color: #FBF6EA; border-left: 3px solid #C99A3C; padding: 12px 16px; font-size: 13px; line-height: 20px; color: #6B5420;'>
          {{notice}}
        </td>
      </tr>
    </table>
  </td>
</tr>
