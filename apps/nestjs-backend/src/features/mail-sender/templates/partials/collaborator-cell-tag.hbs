<tr>
  <td>
    <p class='text' style='margin: 0 0 28px; font-size: 16px; line-height: 26px; color: #3F4749;'>{{{title}}}</p>
    <table role='presentation' class='btn' border='0' cellpadding='0' cellspacing='0'>
      <tr>
        <td style='border-radius: 6px; background-color: #2B7A89;'>
          <a
            href='{{viewRecordUrlPrefix}}?recordId={{lookup recordIds 0}}&fromNotify={{notifyId}}'
            style='display: inline-block; padding: 11px 20px; font-size: 14px; font-weight: 600; line-height: 20px; color: #FFFFFF; text-decoration: none; border-radius: 6px; background-color: #2B7A89;'
          >{{buttonText}}</a>
        </td>
      </tr>
    </table>
    <p class='muted' style='margin: 24px 0 0; font-size: 13px; line-height: 20px; color: #7A8284;'>
      {{linkFallback}}
      <a
        href='{{viewRecordUrlPrefix}}?recordId={{lookup recordIds 0}}&fromNotify={{notifyId}}'
        style='color: #2B7A89; word-break: break-all;'
      >{{viewRecordUrlPrefix}}?recordId={{lookup recordIds 0}}</a>
    </p>
  </td>
</tr>
