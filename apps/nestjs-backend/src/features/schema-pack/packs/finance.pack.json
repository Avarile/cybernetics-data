        {
          "key": "Full_Path",
          "name": "Full Path",
          "type": "formula",
          "options": {
            "expression": "IF({@Parent_Name}, {@Parent_Name}&\" > \"&{@Name}, {@Name})",
            "timeZone": "utc"
          }
