        },
        {
          "key": "Variance",
          "name": "Variance",
          "type": "formula",
          "options": {
            "expression": "{@Planned_Amount} - {@Actual_Spent}",
            "timeZone": "utc",
            "formatting": {
              "type": "currency",
              "precision": 2,
              "symbol": "{{currencySymbol}}"
            }
          }
        },
        {
          "key": "pct_Used",
          "name": "% Used",
          "type": "formula",
          "options": {
            "expression": "IF({@Planned_Amount}=0, 0, ROUND({@Actual_Spent}/{@Planned_Amount}*100, 1))",
            "timeZone": "utc",
            "formatting": {
              "type": "decimal",
              "precision": 1
            }
          }
        }
      ]
    },
