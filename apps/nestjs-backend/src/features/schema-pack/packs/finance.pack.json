  "tables": [
    {
      "key": "finance_Accounts",
      "name": "finance_Accounts",
      "icon": "🏦",
      "fields": [
        {
          "key": "Name",
          "name": "Name",
          "type": "singleLineText",
          "isPrimary": true
        },
        {
          "key": "Scope",
          "name": "Scope",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "Personal",
                "color": "blueLight2"
              },
              {
                "name": "Business",
                "color": "blueLight1"
              }
            ]
          }
        },
        {
          "key": "Type",
          "name": "Type",
          "type": "singleSelect",
          "options": {
            "choices": [
              {
                "name": "Checking",
                "color": "blueLight2"
              },
              {
                "name": "Savings",
                "color": "blueLight1"
              },
              {
                "name": "Credit Card",
                "color": "blueBright"
              },
              {
                "name": "Cash",
                "color": "blue"
              },
              {
                "name": "Investment",
                "color": "blueDark1"
              },
              {
                "name": "Mortgage",
                "color": "redBright"
              }
            ]
          }
        },
        {
          "key": "Institution",
          "name": "Institution",
          "type": "singleLineText"
        },
        {
          "key": "Opening_Balance",
          "name": "Opening Balance",
          "type": "number",
          "options": {
            "formatting": {
              "type": "currency",
              "precision": 2,
              "symbol": "{{currencySymbol}}"
            }
          }
        },
        {
          "key": "Opening_Balance_Date",
          "name": "Opening Balance Date",
          "type": "date",
          "options": {
            "formatting": {
              "date": "YYYY-MM-DD",
              "time": "HH:mm",
              "timeZone": "{{timezone}}"
            }
          }
        },
        {
          "key": "Active",
          "name": "Active",
          "type": "checkbox",
          "options": {
            "defaultValue": true
          }
        },
        {
          "key": "Own_Txn_Total",
          "name": "Own Txn Total",
          "type": "rollup",
          "lookup": {
            "link": "finance_Transactions",
            "field": "Signed_Amount"
          },
          "options": {
            "expression": "sum({values})",
            "formatting": {
              "type": "currency",
              "precision": 2,
              "symbol": "{{currencySymbol}}"
            }
          }
        },
        {
          "key": "Incoming_Transfer_Total",
          "name": "Incoming Transfer Total",
          "type": "rollup",
          "lookup": {
            "link": "finance_Transactions_linked",
            "field": "Amount"
          },
          "options": {
            "expression": "sum({values})",
            "formatting": {
              "type": "currency",
              "precision": 2,
              "symbol": "{{currencySymbol}}"
            }
          }
        },
        {
          "key": "Net_Activity",
          "name": "Net Activity",
          "type": "formula",
          "options": {
            "expression": "{@Own_Txn_Total} + {@Incoming_Transfer_Total}",
            "timeZone": "utc",
            "formatting": {
              "type": "currency",
              "precision": 2,
              "symbol": "{{currencySymbol}}"
            }
          }
        },
        {
          "key": "Current_Balance",
          "name": "Current Balance",
          "type": "formula",
          "options": {
            "expression": "{@Opening_Balance} + {@Net_Activity}",
            "timeZone": "utc",
            "formatting": {
              "type": "currency",
              "precision": 2,
              "symbol": "{{currencySymbol}}"
            }
          }
        }
      ]
    },
